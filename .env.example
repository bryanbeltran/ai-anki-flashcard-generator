# Keep the offline provider for reproducible local runs.
ANKI_AI_PROVIDER=deterministic
ANKI_DATA_DIR=data
PORT=3000
HOST=127.0.0.1
# Keep unset for the local-only boundary. Do not enable this without adding
# authentication, tenant isolation, SSRF/egress, rate-limit, and CSRF controls.
# RECALL_ALLOW_PUBLIC=true
# RECALL_TMP_DIR=/var/tmp

# Optional Codex/OpenAI Responses API provider:
# ANKI_AI_PROVIDER=openai
# OPENAI_API_KEY=replace-me
# OPENAI_MODEL=gpt-5
